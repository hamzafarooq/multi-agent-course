# Required: get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: model override
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: get one at https://tavily.com/ (free tier). If left blank,
# Levels 3 and 4 fall back to mocked search results so the demo still runs.
TAVILY_API_KEY=

# --- Retrieval -------------------------------------------------------------
# Which embedding provider builds the index and embeds incoming questions.
#
#   openai  text-embedding-3-small over the API. Nothing to install beyond the
#           openai client, so this is the only option that can be deployed.
#   local   nomic-embed-text-v1.5 through sentence-transformers. No API key and
#           no network, but it pulls in ~525MB of torch and cannot be deployed.
#
# The index records which provider built it, and querying it with a different
# one is a hard error - the vectors would otherwise be silently meaningless.
# Change this and you must re-run: python backend/build_index.py
EMBEDDING_PROVIDER=openai

# Required when EMBEDDING_PROVIDER=openai. The project this key belongs to
# needs model access to text-embedding-3-small: OpenAI dashboard ->
# Project -> Limits -> Model access. A key that works for chat is NOT
# necessarily allowed to call the embeddings endpoint.
OPENAI_API_KEY=

# Optional overrides
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Optional: minimum cosine similarity for a chunk to count as a match. Left
# unset, it follows whichever provider built the index (openai 0.30,
# local 0.62). Re-measure against a few off-topic questions before trusting it.
# RAG_MIN_SCORE=

# --- Paths (relative ones resolve against backend/) ------------------------
RAG_DOCUMENT_PATH=../Project-Management-2nd-Edition-1729807212.pdf
# RAG_DATA_DIR=../data
# RAG_INDEX_DIR=../index
